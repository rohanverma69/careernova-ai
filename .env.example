# ==========================================================
# CareerNova AI - Environment Variables
# ==========================================================

# Flask Secret Key for session signing & CSRF protection
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars-min

# Environment Mode: 'production' or 'development'
FLASK_ENV=development
FLASK_DEBUG=0

# Database Connection URL (PostgreSQL in Production, e.g. Neon, Supabase, Vercel Postgres)
# In development, leave empty to automatically fallback to local sqlite:///careernova.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional AI API Key (e.g. Google Gemini or OpenAI compatible)
# The application functions completely without this key using the built-in
# rule-based recommendation engine. When supplied, it enriches advice with AI commentary.
AI_API_KEY=
AI_PROVIDER=gemini
